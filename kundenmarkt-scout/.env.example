# Local development: copy to .env.local. Never place secrets in NEXT_PUBLIC_*.
# Public headline search works without a key: google (default) or bing.
WEB_RESEARCH_PROVIDER=google

# Later SAP integration; leave blank until the customer-owned OData projection exists.
# Use HTTPS; localhost HTTP is supported only for integration development.
SAP_ODATA_BASE_URL=
# Relative to the base URL, e.g. Customers
SAP_ODATA_CUSTOMERS_PATH=
# Relative path MUST include {kundenNr}, e.g. CustomerSales('{kundenNr}')
SAP_ODATA_SALES_PATH=
# Canonical customer projection uses kundenNr / name; change for your schema.
SAP_CUSTOMER_ID_FIELD=kundenNr
SAP_CUSTOMER_NAME_FIELD=name

# Use either a server-side bearer token or Basic credentials, never both in the browser.
SAP_BEARER_TOKEN=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT=

# Optional generative briefing. BOTH values must be configured server-side.
# Model is an explicit deployment choice; no default model is assumed.
# Only public source metadata is sent. No SAP/customer numbers or sales data.
OPENAI_API_KEY=
OPENAI_MODEL=

# North Data needs a licensed integration; no working adapter is configured yet.
